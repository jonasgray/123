{
  "identity": {
    "agentName": "state_department_travel_advisory_agent",
    "displayName": "US State Department Travel Advisory Checker",
    "description": "An agent that returns current U.S. State Department travel advisory levels for a requested destination.",
    "version": "1.0.0",
    "provider": {
      "organization": "state_department_travel_advisory_agent"
    }
  },
  "capabilities": {
    "taskKinds": [
      "request"
    ]
  },
  "tags": [
    {
      "id": "travel_advisory",
      "name": "Travel Advisory",
      "description": "Looks up official State Department destination risk levels."
    }
  ],
  "io": {
    "inputs": [
      {
        "id": "request",
        "description": "Submit the name of the country or destination you would like to research.",
        "contentType": "application/json",
        "required": true,
        "example": {
          "country": "Belize"
        },
        "schema": {
          "type": "object",
          "required": [
            "country"
          ],
          "properties": {
            "country": {
              "type": "string",
              "title": "Country or destination",
              "default": "Belize"
            }
          }
        }
      }
    ],
    "outputs": [
      {
        "id": "advisory",
        "description": "State Department travel advisory result.",
        "contentType": "text/plain",
        "guaranteed": true
      }
    ]
  },
  "runtime": {
    "handler": "./handler.py",
    "handlerExport": "handler",
    "concurrency": 1,
    "expectedInstances": 1,
    "maxRunningTimeSec": 60
  }
}
